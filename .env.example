# Copy this file to `.env` and edit. Every value is optional.
# With no API key at all the service still runs in "extractive" mode:
# it returns the best-matching sentences instead of a generated answer.
# All DOCQA_* settings are described in the README (Configuration).

# --- LLM: pick ONE provider ----------------------------------------------
# Anthropic (Claude):
# ANTHROPIC_API_KEY=your-key-here
# DOCQA_LLM_PROVIDER=anthropic
# DOCQA_LLM_MODEL=claude-haiku-5-5

# OpenAI, or any server that speaks the OpenAI API (Groq, Ollama, OpenRouter, ...):
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=http://localhost:11434/v1
# DOCQA_LLM_PROVIDER=openai
# DOCQA_LLM_MODEL=the-model-name-your-provider-offers

# Seconds to wait for the language model before giving up:
# DOCQA_LLM_TIMEOUT=60

# --- Retrieval --------------------------------------------------------------
# auto = Sentence-Transformers if installed, otherwise the weaker offline hashing embedder.
# Use sentence-transformers explicitly in production so a missing model is an error, not a silent downgrade.
# DOCQA_EMBEDDING_BACKEND=auto
# DOCQA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DOCQA_CHUNK_SIZE=180
# DOCQA_CHUNK_OVERLAP=30
# DOCQA_TOP_K=4
# Chunks less similar than this are treated as "not relevant" (empty = the embedder's default).
# DOCQA_MIN_SCORE=0.2

# --- Service ----------------------------------------------------------------
# DOCQA_DATA_DIR=data   # leave this out in Docker: the image already keeps the index in /data
# DOCQA_MAX_UPLOAD_MB=10
# If set, the document and question endpoints need this value in an X-API-Key header
# (/health and the /docs pages stay open).
# Set it before exposing the service to the internet: each question can cost LLM credits.
# DOCQA_API_KEY=change-me
